rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /teacherExams/{dataset}/files/{group} {
      allow get: if request.auth != null
        && request.auth.uid == 'AGOOU43jEYaHaB5BCqw4wpWiqax1';
      // Publikacja plików przez właściciela projektu z użyciem IAM.
      allow list, write: if false;
    }
    match /school/content {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == 'AGOOU43jEYaHaB5BCqw4wpWiqax1'
        && request.resource.data.keys().hasOnly([
          'version', 'items', 'revision', 'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500
        && request.resource.data.revision is int;

      allow delete: if false;
    }
  }
}