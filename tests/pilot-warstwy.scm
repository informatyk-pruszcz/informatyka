; GIMP 2.10 Script-Fu. Zapisujemy wyłącznie w katalogu tymczasowym testu.
(define (names image)
  (let* ((layers (gimp-image-get-layers image)) (ids (cadr layers)))
    (map (lambda (id) (car (gimp-item-get-name id))) (vector->list ids))))
(define (check-project filename expected position corrected)
  (let* ((src (string-append "klasa7/pilot-warstwy/" filename "-start.xcf"))
         (dest (string-append (getenv "RUNNER_TEMP") "/" filename "-gotowy.xcf"))
         (image (car (gimp-file-load RUN-NONINTERACTIVE src src)))
         (layer (vector-ref (cadr (gimp-image-get-layers image)) position)))
    (if (not (equal? (names image) expected)) (error "Niepoprawna kolejnosc poczatkowa"))
    (gimp-image-raise-item image layer)
    (gimp-xcf-save RUN-NONINTERACTIVE image layer dest dest)
    (gimp-image-delete image)
    (let ((saved (car (gimp-file-load RUN-NONINTERACTIVE dest dest))))
      (if (not (equal? (names saved) corrected)) (error "Niepoprawna kolejnosc po zapisie"))
      (gimp-image-delete saved))))
(check-project "plakat" '("Ilustracja" "Tytuł" "Papier") 1 '("Tytuł" "Ilustracja" "Papier"))
(check-project "mapa" '("Legenda" "Plan" "Meta" "Papier") 2 '("Legenda" "Meta" "Plan" "Papier"))
(call-with-output-file (string-append (getenv "RUNNER_TEMP") "/gimp-pilot-ok") (lambda (port) (display "OK" port)))
